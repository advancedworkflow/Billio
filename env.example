# =============================================================================
# Billio — variables d'environnement
# Développement : copier en .env (seules SECRET_KEY / DEBUG sont utiles en local).
# Production : copier en .env.production (VPS) ou les saisir chez l'hébergeur.
# Où trouver chaque valeur : DEPLOIEMENT.md
# =============================================================================

# --- Django -------------------------------------------------------------------
# 50 caractères aléatoires : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod
# Domaine(s) servis, séparés par des virgules
ALLOWED_HOSTS=billio.fr,www.billio.fr
# Adresse publique (liens des emails, retours Stripe et Google)
SITE_URL=https://billio.fr
CSRF_TRUSTED_ORIGINS=https://billio.fr,https://www.billio.fr
# Admin Django à une adresse non devinable (garder le / final)
ADMIN_URL=gestion-a-changer/
# Nombre de proxys devant l'application (1 chez la plupart des hébergeurs et avec Caddy)
NUM_PROXIES=1

# --- VPS uniquement (docker-compose.yml) --------------------------------------
DOMAIN=billio.fr
POSTGRES_PASSWORD=

# --- Base de données (hébergeur « plateforme » / base managée) ----------------
# postgres://utilisateur:motdepasse@hote:5432/base
DATABASE_URL=
# 1 = connexion chiffrée exigée (bases managées) ; 0 sur un VPS avec la base dans docker compose
DATABASE_SSL=1
# Facultatif : cache partagé Redis (sinon une table de la base est utilisée)
REDIS_URL=

# --- Emails (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# DigitalOcean (et d'autres hébergeurs) bloquent les ports SMTP 25/465/587 :
# Resend accepte aussi 2587 (STARTTLS), qui n'est pas bloqué
EMAIL_PORT=2587
# Le domaine doit être vérifié dans Resend (DNS SPF / DKIM)
DEFAULT_FROM_EMAIL=Billio <no-reply@billio.fr>
SERVER_EMAIL=alertes@billio.fr

# --- Fichiers déposés : stockage objet S3-compatible (recommandé) -------------
# Scaleway : endpoint https://s3.fr-par.scw.cloud, région fr-par
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# --- Monitoring ----------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Worker (tâches planifiées) et sauvegardes ----------------------------------
WORKER_INTERVAL=600
BACKUP_DAILY=1
BACKUP_RETENTION_DAYS=14
WEB_CONCURRENCY=3

# --- Abonnements Billio (compte Stripe DE BILLIO, pas ceux des clients) --------
# Puis : python manage.py stripe_sync_plans ; webhook <SITE_URL>/subscriptions/webhooks/stripe/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# TVA : identifiant d'un taux Stripe (txr_…) ou Stripe Tax (STRIPE_AUTOMATIC_TAX=1)
STRIPE_TAX_RATE_ID=
STRIPE_AUTOMATIC_TAX=0

# --- Google (facultatif : connexion Google, Google Drive) -----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- IA (facultatif : génération de documents) ---------------------------------
ANTHROPIC_API_KEY=

# --- Informations légales de l'éditeur (Mentions légales / CGU / Confidentialité)
LEGAL_COMPANY_NAME=
LEGAL_FORM=SAS
LEGAL_CAPITAL=
LEGAL_ADDRESS=
LEGAL_SIREN=
LEGAL_RCS=
LEGAL_VAT_NUMBER=
LEGAL_DIRECTOR=
LEGAL_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_LOCATION=France
LEGAL_COURT=tribunal de commerce de Paris

# « Se connecter avec… » (OAuth) : une app à déclarer chez chaque outil, URL de redirection
# https://<votre-domaine>/integrations/oauth/<outil>/callback/ (voir le panneau de l'outil, compte administrateur).
# Sans ces variables, l'outil se connecte par le formulaire (clé à coller).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Trello : clé API du Power-Up (origine autorisée : https://<votre-domaine>)
TRELLO_API_KEY=
